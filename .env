# ============================ Modelos (Ollama) ============================
# LLM principal. Alternativas probadas con esta arquitectura (todas locales):
#   qwen3:4b-instruct (por defecto, ~2.5 GB, Qwen3-4B-Instruct-2507, sin razonamiento -> respuestas directas)
#   qwen3:4b          (variante *thinking*; en CPU es lenta y con LLM_THINK=false filtra razonamiento en la respuesta)
#   qwen3:1.7b   llama3.2:3b   gemma3:4b   phi4-mini   llama3.1:8b   mistral:7b   qwen3:8b   deepseek-r1:8b
LLM_MODEL=qwen3:4b-instruct
# Modelos adicionales a descargar (separados por espacio) para poder cambiarlos desde la UI.
EXTRA_MODELS=qwen3:4b
# Modelo de embeddings. granite-embedding:30m (384d, inglés, 512 tok) es ~5x más rápido en CPU que nomic-embed-text.
# Alternativas: nomic-embed-text (768d), all-minilm (384d), snowflake-arctic-embed:xs (384d),
#               mxbai-embed-large (1024d), bge-m3 (1024d, multilingüe, lento en CPU).
# Cambiarlo requiere FORCE_REINGEST=true.
EMBED_MODEL=granite-embedding:30m
EMBED_BATCH_SIZE=32
# Prefijos de tarea (vacío = automático: nomic-embed usa "search_document:"/"search_query:")
EMBED_DOC_PREFIX=
EMBED_QUERY_PREFIX=

# Modo "thinking" de los modelos razonadores (qwen3, deepseek-r1, gpt-oss): true | false
LLM_THINK=false
LLM_TEMPERATURE=0.1
# Ventana de contexto: 4096 basta para top_k=5 (5 x ~350 tok) + prompt + respuesta y ahorra RAM/CPU
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=1024
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1

# ============================ Conexiones ============================
OLLAMA_URL=http://ollama:11434
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=mitre_attack

# ============================ Corpus MITRE ATT&CK ============================
# Dominios STIX 2.1 (separados por coma): enterprise-attack, mobile-attack, ics-attack
ATTACK_DOMAINS=enterprise-attack
ATTACK_BASE_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master
# Máximo de "procedure examples" (grupo/software -> técnica) incluidos por técnica
MAX_PROCEDURE_EXAMPLES=25
# Volver a descargar el STIX aunque exista en /data
REFRESH_CORPUS=false
# Reconstruir la colección aunque ya tenga puntos
FORCE_REINGEST=false

# ============================ Chunking / Retrieval ============================
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=5
# Estrategia de recuperación por defecto: hybrid (densa + BM25 con fusión RRF) | dense | sparse
RETRIEVAL_MODE=hybrid
DATA_DIR=/data
# Timeout (s) de las llamadas a Ollama; en CPU una respuesta RAG puede tardar varios minutos
REQUEST_TIMEOUT=1800
